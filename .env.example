# Server
SERVER_PORT=8080

# Database Migrations
MIGRATIONS_PATH=migrations

# PostgreSQL Database (Supabase Session Pooler — IPv4)
POSTGRES_HOST=aws-1-eu-central-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.sdhlcmhzujflfrfdtuyc
POSTGRES_PASSWORD=your_password_here
POSTGRES_SSLMODE=require

# Database Initialization
IS_INIT_DB=true

# JWT Configuration (Supabase JWT Secret from Settings → API)
JWT_SECRET_KEY=your_jwt_secret_here

# Object Storage (Supabase Storage)
SUPABASE_HOST=sdhlcmhzujflfrfdtuyc.supabase.co
SUPABASE_USE_SSL=true
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=avatars

# Test/Development OAuth (optional - for testing Supabase Auth)
SUPABASE_URL=https://sdhlcmhzujflfrfdtuyc.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_EMAIL=test@gmail.com
